{

	57_190: {
		cardInfo: {
			//id: 7_190.1
			parent: 7_190
			variant: ERRATA
			variantPath: promos/pc
			revision: 1
			image: errata/LOTR-EN07E190.1_card.jpg
			collInfo: 7U190
			rarity: U
		}
		title: Morgul Destroyer
		unique: false
		side: Shadow
		culture: Wraith
		twilight: 3
		type: Minion
		race: Orc
		strength: 6
		vitality: 2
		site: 4
		effects: [
			{
				type: Trigger
				optional: true
				text: Would you like to spot a Nazgul to add 1 threat?
				requires: {
					type: CanSpot
					filter: nazgul
				}
				trigger: {
					type: played
					filter: self
				}
				effect: 
				{
					// RULED: "The Free Peoples player may make YOU wound a
					// companion to prevent this."
					//
					// The FREE PEOPLES PLAYER is always the one offered the
					// chance -- `player: freeps` below, unchanged and correct.
					// What they buy is having THIS MINION'S CONTROLLER wound one
					// of the FREE PEOPLES PLAYER'S OWN companions.
					//
					// Two things were wrong above two players, and the offer was
					// not one of them:
					//
					//   player: shadow  -> getFirstShadowPlayer, routinely some
					//                      other seat than the one who played
					//                      this minion. Shadow players always
					//                      control their own minions, so the
					//                      minion's owner IS "you".
					//   choose(companion) -> unscoped, and at five seats every
					//                      seat has its own companions on the
					//                      table, so the wound could land on a
					//                      player the card never names.
					//
					// `owner`, not `you`: this sits in a prevent COST, and
					// PreventableEffectAppender appends the cost in a context
					// delegated to whoever ACCEPTED -- the Free Peoples player.
					// `owner` reads getSource().getOwner() and the delegate
					// passes the source through untouched.
					//
					// Same sentence, same ruling and same pair of fixes as
					// 4_256 Southron Troop.
					type: preventable
					player: freeps
					cost: {
						type: wound
						player: owner
						times: 1
						select: choose(ownedByFreePeoplesPlayer,companion)
					}
					text: Make the Shadow player wound a companion to prevent adding a threat?
					effect: {
						type: AddThreats
						amount: 1
					}
				}
			}
			{
				type: activated
				phase: Skirmish
				cost: {
					type: RemoveThreats
					amount: 1
				}
				effect: {
					type: ModifyStrength
					select: self
					amount: 3
				}
			}
		]
		gametext: When you play this minion, you may spot a Nazgûl to add a threat. The<br>Free Peoples player may make you wound a companion to prevent this. <br><b>Skirmish:</b> Remove a threat to make this minion strength +4.
		lore: ""
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}
}
