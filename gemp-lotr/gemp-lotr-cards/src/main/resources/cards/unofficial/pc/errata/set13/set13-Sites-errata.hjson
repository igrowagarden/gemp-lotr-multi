		title: Courtyard Parapet
		type: site
		block: Shadows
		twilight: 0
		keyword: Dwelling
		direction: left
		effects: [
			{
				type: Trigger
				optional: true
				trigger: {
					type: movesTo
					filter: self
				}
				requires: {
					type: location
					filter: regionNumber(2)
				}
				// DO NOT "FIX" THIS ONE. The printed text says "the FIRST
				// Shadow player may discard 2 cards from hand", and
				// getFirstShadowPlayer returns exactly that -- the first Shadow
				// player counter-clockwise from the Free Peoples player. Both
				// tokens here are correct as written and stay correct at five
				// seats.
				//
				// It is the one card the census flags where `shadow` is the
				// intended answer rather than a two-player accident, so a
				// mechanical sweep of the remaining tokens would break it.
				effect: {
					type: optional
					player: shadow
					text: Would you like to discard 2 cards from hand to add a burden?
					cost: {
						type: discardFromHand
						hand: shadowPlayer
						player: shadowPlayer
						forced: false
						count: 2
					}
					effect: {
						type: addBurdens
					}
				}
			}
		]
		gametext: <b>Dwelling.</b>When the fellowship moves to this site in region 2, the <br>first Shadow player may discard 2 cards from hand to add a burden.
		lore: ""
		promotext: ""
