{

	18_134: {
		cardInfo: {
			image: decipher/LOTR18134.jpg
			collInfo: 18U134
			rarity: U
		}
		title: Doorway to Doom
		unique: false
		twilight: 1
		type: Site
		block: Shadows
		direction: Right
		keywords: Mountain
		effects: [
			{
				type: Trigger
				optional: false
				trigger: {
					type: movesTo
					filter: self
				}
				// "EACH PLAYER wounds two of HIS OR HER characters." Written as
				// an FP half plus a Shadow half, which is the same sentence only
				// while there are exactly two players. Above two, the Shadow half
				// fired once for whichever seat getFirstShadowPlayer named and
				// the other opponents were skipped entirely -- and its
				// `side(shadow)` select is not scoping, so that one seat chose
				// from every opponent's characters.
				//
				// `your` inside forEachPlayer does the scoping for free: it
				// resolves to Filters.owner(performingPlayer) and each iteration
				// runs with that player performing. See 19_4.
				effect: {
					type: forEachPlayer
					player: eachPlayer
					effect: {
						type: wound
						player: you
						select: choose(your,character)
						count: 2
					}
				}
			}
		]
		gametext: <b>Mountain</b>. When the fellowship moves to this site, each player wounds two of his or her characters.
		lore: ""
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

