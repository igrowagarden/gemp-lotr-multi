	18_136: {
		cardInfo: {
			image: decipher/LOTR18136.jpg
			collInfo: 18U136
			rarity: U
		}
		title: Mithlond
		unique: false
		twilight: 2
		type: Site
		block: Shadows
		direction: Left
		keywords: River
		effects: [
			{
				type: Trigger
				optional: false
				trigger: {
					type: movesTo
					filter: self
				}
				// "EACH PLAYER heals each of HIS OR HER characters." Same shape as
				// 18_134 above and the same fix; see the note there.
				effect: {
					type: forEachPlayer
					player: eachPlayer
					effect: {
						type: heal
						player: you
						select: all(your,character)
					}
				}
			}
		]
		gametext: <b>River</b>. When the fellowship moves to this site, each player heals each of his or her characters.
		lore: ""
		promotext: ""
		alts: {
			promos: {
			}
			errata: {
			}
		}
	}

